{
  "info": {
    "_postman_id": "1bd91be8-a85a-4a1b-9700-e0f48b0bf076",
    "name": "Gunung Kerinci API - Mobile Beranda & Booking",
    "description": "Collection endpoint mobile untuk beranda, booking awal, formulir, pembayaran, struk, tiket, dan my tiket. Jalankan Login dulu agar bearer_token terisi otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login berhasil', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json?.data?.token) pm.collectionVariables.set('bearer_token', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],
            "body": {"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}","options":{"raw":{"language":"json"}}},
            "url": {"raw":"{{base_url}}/api/login","host":["{{base_url}}"],"path":["api","login"]}
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Beranda & Tiket Awal",
      "item": [
        {"name":"Menu Beranda","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/beranda","host":["{{base_url}}"],"path":["api","beranda"]}},"response":[]},
        {"name":"Daftar Destinasi","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const json = pm.response.json();","if (Array.isArray(json?.data) && json.data.length) pm.collectionVariables.set('destinasi_id', json.data[0].id);"]}}],"request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/destinasi","host":["{{base_url}}"],"path":["api","destinasi"]}},"response":[]},
        {"name":"Detail Destinasi","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/destinasi/{{destinasi_id}}","host":["{{base_url}}"],"path":["api","destinasi","{{destinasi_id}}"]}},"response":[]},
        {"name":"Paket Tiket Destinasi","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const json = pm.response.json();","if (Array.isArray(json?.data?.paket) && json.data.paket.length) pm.collectionVariables.set('paket_id', json.data.paket[0].id);"]}}],"request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/destinasi/{{destinasi_id}}/paket","host":["{{base_url}}"],"path":["api","destinasi","{{destinasi_id}}","paket"]}},"response":[]},
        {"name":"Detail Tiket Paket","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/destinasi/paket/{{paket_id}}/tiket","host":["{{base_url}}"],"path":["api","destinasi","paket","{{paket_id}}","tiket"]}},"response":[]}
      ]
    },
    {
      "name": "03 Booking",
      "item": [
        {"name":"Create/Update Booking Awal","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const json = pm.response.json();","if (json?.data?.id) pm.collectionVariables.set('booking_id', json.data.id);","if (Array.isArray(json?.data?.pendakis) && json.data.pendakis.length) pm.collectionVariables.set('pendaki_id', json.data.pendakis[0].id);","if (Array.isArray(json?.data?.pendakis) && json.data.pendakis.length) pm.collectionVariables.set('kode_bio', json.data.pendakis[0].id_bio);"]}}],"request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"date_start\": \"{{date_start}}\",\n  \"date_end\": \"{{date_end}}\",\n  \"wni\": 1,\n  \"wna\": 0,\n  \"jenis_tiket\": \"{{paket_id}}\",\n  \"gerbang_masuk\": \"{{gate_masuk_id}}\",\n  \"gerbang_keluar\": \"{{gate_keluar_id}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{base_url}}/api/booking/destinasi/paket/tiket","host":["{{base_url}}"],"path":["api","booking","destinasi","paket","tiket"]}},"response":[]},
        {"name":"Detail Booking","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}"]}},"response":[]},
        {"name":"Setujui SNK","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id\": \"{{booking_id}}\",\n  \"snk\": true\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{base_url}}/api/booking/snk","host":["{{base_url}}"],"path":["api","booking","snk"]}},"response":[]},
        {"name":"Data Formulir","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}/formulir","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}","formulir"]}},"response":[]},
        {"name":"Tambah Pendaki","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"booking\": \"{{booking_id}}\",\n  \"code\": \"{{kode_bio_tambahan}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{base_url}}/api/booking/formulir/pendaki/add","host":["{{base_url}}"],"path":["api","booking","formulir","pendaki","add"]}},"response":[]},
        {"name":"Simpan Formulir","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id_booking\": \"{{booking_id}}\",\n  \"action\": \"save\",\n  \"formulir\": [\n    {\n      \"id_pendaki\": \"{{pendaki_id}}\",\n      \"kode_bio\": \"{{kode_bio}}\",\n      \"no_hp_darurat\": \"+6281234567890\"\n    }\n  ],\n  \"barang_bawaan\": [\n    {\"nama_barang\": \"Carrier\", \"jumlah\": 1}\n  ]\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{base_url}}/api/booking/formulir","host":["{{base_url}}"],"path":["api","booking","formulir"]}},"response":[]},
        {"name":"Finalisasi Formulir","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id_booking\": \"{{booking_id}}\",\n  \"action\": \"next\",\n  \"barangWajib\": true,\n  \"formulir\": [\n    {\n      \"id_pendaki\": \"{{pendaki_id}}\",\n      \"kode_bio\": \"{{kode_bio}}\",\n      \"no_hp_darurat\": \"+6281234567890\"\n    }\n  ],\n  \"barang_bawaan\": [\n    {\"nama_barang\": \"Carrier\", \"jumlah\": 1}\n  ]\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{base_url}}/api/booking/formulir","host":["{{base_url}}"],"path":["api","booking","formulir"]}},"response":[]}
      ]
    },
    {
      "name": "04 Payment & Output",
      "item": [
        {"name":"Detail Booking Review","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}/detail","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}","detail"]}},"response":[]},
        {"name":"Data Payment","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}/payment","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}","payment"]}},"response":[]},
        {"name":"Upload Bukti Pembayaran","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"POST","header":[{"key":"Accept","value":"application/json"}],"body":{"mode":"formdata","formdata":[{"key":"id","value":"{{booking_id}}","type":"text"},{"key":"metode","value":"transfer","type":"text"},{"key":"bukti_pembayaran","type":"file","src":""}]},"url":{"raw":"{{base_url}}/api/booking/payment","host":["{{base_url}}"],"path":["api","booking","payment"]}},"response":[]},
        {"name":"Hapus Bukti Pembayaran","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"DELETE","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"booking_id\": \"{{booking_id}}\"\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{base_url}}/api/booking/payment/{{payment_id}}","host":["{{base_url}}"],"path":["api","booking","payment","{{payment_id}}"]}},"response":[]},
        {"name":"Struk","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}/struk","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}","struk"]}},"response":[]},
        {"name":"Tiket","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}/tiket","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}","tiket"]}},"response":[]},
        {"name":"My Tiket","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/mytiket","host":["{{base_url}}"],"path":["api","mytiket"]}},"response":[]},
        {"name":"Cancel Booking","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{bearer_token}}","type":"string"}]},"method":"DELETE","header":[{"key":"Accept","value":"application/json"}],"url":{"raw":"{{base_url}}/api/booking/{{booking_id}}","host":["{{base_url}}"],"path":["api","booking","{{booking_id}}"]}},"response":[]}
      ]
    }
  ],
